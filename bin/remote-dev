#!/usr/bin/env bash

set -euo pipefail

ssh_target="${REMOTE_DEV_SSH_TARGET:-nixos-remote-dev}"

die() {
  printf 'remote-dev: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

sanitize_id() {
  local value
  value="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  value="${value//[^a-z0-9_.-]/-}"
  value="${value#-}"
  value="${value%-}"
  [[ -n "${value}" ]] || die "identifier is empty after normalization"
  [[ "${#value}" -le 48 ]] || die "identifier is longer than 48 characters: ${value}"
  printf '%s\n' "${value}"
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null ||
    die "run this command inside a Git worktree"
}

host_id() {
  sanitize_id "${REMOTE_DEV_HOST_ID:-$(hostname -s)}"
}

repo_id() {
  local root="$1"
  local origin name
  origin="$(git -C "${root}" config --get remote.origin.url || true)"
  if [[ -n "${origin}" ]]; then
    name="${origin##*/}"
    name="${name%.git}"
  else
    name="$(basename -- "${root}")"
  fi
  sanitize_id "${name}"
}

branch_id() {
  local branch
  branch="$(git -C "$1" branch --show-current)"
  [[ -n "${branch}" ]] || die "detached HEAD is not supported"
  sanitize_id "${branch}"
}

rsync_excludes() {
  cat <<'EOF'
.git
node_modules
.direnv
result
result-*
.next
.nuxt
.output
dist
build
coverage
.cache
.turbo
.vite
.remote-dev-local
EOF
}

cmd_sync() {
  require_command git
  require_command rsync
  require_command ssh

  local root host repo branch remote_rel
  root="$(repo_root)"
  host="$(host_id)"
  repo="$(repo_id "${root}")"
  branch="$(branch_id "${root}")"
  remote_rel="workspace/remote-dev/${host}/${repo}/${branch}"

  ssh "${ssh_target}" "mkdir -p -- '${remote_rel}'"

  local -a args=(
    -az
    --delete
  )
  local exclude
  while IFS= read -r exclude; do
    [[ -n "${exclude}" ]] && args+=(--exclude "${exclude}")
  done < <(rsync_excludes)

  rsync "${args[@]}" "${root}/" "${ssh_target}:${remote_rel}/"

  printf 'Synced to %s:~/%s\n' "${ssh_target}" "${remote_rel}"
  printf 'ssh %s\n' "${ssh_target}"
  printf 'cd ~/%s\n' "${remote_rel}"
}

cmd_doctor() {
  local failed=0 command
  for command in git rsync ssh; do
    if command -v "${command}" >/dev/null 2>&1; then
      printf 'ok: %s\n' "${command}"
    else
      printf 'missing: %s\n' "${command}" >&2
      failed=1
    fi
  done

  if ssh -o BatchMode=yes "${ssh_target}" true; then
    printf 'ok: ssh %s\n' "${ssh_target}"
  else
    printf 'failed: ssh %s\n' "${ssh_target}" >&2
    failed=1
  fi

  return "${failed}"
}

usage() {
  cat <<'EOF'
Usage:
  remote-dev          Sync the current Git worktree to NixOS
  remote-dev doctor   Check local commands and SSH connectivity
EOF
}

case "${1:-}" in
  "") cmd_sync ;;
  doctor) shift; [[ "$#" -eq 0 ]] || die "usage: remote-dev doctor"; cmd_doctor ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
