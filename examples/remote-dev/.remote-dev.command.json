{
  "version": 1,
  "project": "example-app",
  "runner": {
    "type": "command",
    "command": [
      "npm",
      "run",
      "dev",
      "--",
      "--host",
      "127.0.0.1"
    ]
  },
  "ports": {
    "web": {
      "env": "PORT",
      "scheme": "http",
      "health": {
        "path": "/",
        "timeoutSeconds": 120
      }
    }
  },
  "sync": {
    "ignore": []
  },
  "secrets": [
    ".env.local"
  ]
}
